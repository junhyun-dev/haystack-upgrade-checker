# Open WebUI v0.11.3 local configuration for this workspace.
# Loaded by scripts/serve.sh. No secrets here; WEBUI_SECRET_KEY is read from runtime/.webui_secret_key.
# Every value below has a source line in vendor/open-webui/backend/open_webui/{env,config}.py at tag v0.11.3.

# Bind to loopback only.
HOST=127.0.0.1
PORT=8080

# Keep all product state inside the (git-ignored) runtime directory.
DATA_DIR=$ROOT/runtime/data
SENTENCE_TRANSFORMERS_HOME=$ROOT/runtime/cache/models
HF_HOME=$ROOT/runtime/cache/models
TIKTOKEN_CACHE_DIR=$ROOT/runtime/cache/tiktoken
WHISPER_MODEL_DIR=$ROOT/runtime/cache/whisper

# No automatic downloads and no version check (env.py: OFFLINE_MODE sets HF_HUB_OFFLINE=1 and disables the update check).
OFFLINE_MODE=true
ENABLE_VERSION_UPDATE_CHECK=false
RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
RAG_RERANKING_MODEL_AUTO_UPDATE=false
WHISPER_MODEL_AUTO_UPDATE=false

# Model endpoint: local llama.cpp server only (scripts/llm_server.sh). Ollama stays off.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true

# Telemetry off (same keys the upstream Dockerfile sets).
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_OTEL=false

# Local accounts only; first sign-up becomes admin. Community sharing off.
WEBUI_AUTH=true
ENABLE_SIGNUP=true
ENABLE_COMMUNITY_SHARING=false

# Retrieval defaults kept as upstream (recorded here so changes are explicit later).
# RAG_EMBEDDING_ENGINE=            (empty = local sentence-transformers)
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_DB=chroma
# RAG_TOP_K=3
# ENABLE_RAG_HYBRID_SEARCH=
# ENABLE_KB_EXEC=false
OPENAI_API_BASE_URL=http://127.0.0.1:8081/v1
OPENAI_API_KEY=local

# Local patch 0001 (patches/0001-rag-dedup-by-file.patch): prefer one best chunk per file before filling top-k. Off = upstream behavior.
RAG_DEDUP_BY_FILE=true
RAG_DEDUP_CANDIDATE_MULTIPLIER=4
